// Nexium Setup -- a graphical installer and uninstaller for Nexium, written in Nexa.
// The interface is drawn with std/ui (NexaC 0.1.15 or newer).
//
// This file builds the setup *stub*. installer/pack.nxa appends the payload
// (Nexium.exe, nexium.ico, README.md, LICENSE) and a manifest to the stub, so
// the finished NexiumSetup.exe is one self-contained file. At run time the
// stub reads its own executable and extracts what it needs.
//
// The payload also carries the MinGW runtime DLLs Nexium.exe links against;
// they are installed next to it.
//
// Build everything with:  mingw32-make installer   (see the Makefile)
//
// Command line:
//   NexiumSetup.exe                     interactive install
//   NexiumSetup.exe --silent [options]  unattended install (exit code 0 on success)
//   Uninstall.exe --uninstall [--silent] [--scope User|Machine]
// Options: --scope User|Machine  --dir <path>  --desktop 0|1  --startmenu 0|1
//          --assoc 0|1  --path 0|1  --nexa 0|1 (install the Nexa compiler if missing)
#include <std/io>
#include <std/os>
#include <std/file>
#include <std/ui>

let VERSION = "2.1.0";
let NEXA_URL = "https://github.com/Bobism-2009/Nexa-Lang/releases";

let W = 860;
let H = 560;
let SIDEBAR = 240;
let CX = 280;           // left edge of the page content
let CW = 540;           // width of the page content
let FOOT = 492;         // top of the button bar

// std/ui "dark" theme colours, for the parts drawn directly with gfx.
let C_SIDEBAR = 0x16171A;
let C_LINE = 0x2C2E33;
let C_TEXT = 0xE8E9EC;
let C_MUTED = 0x9CA1AA;
let C_ACCENT = 0x0078D4;
let C_OK = 0x3FB950;
let C_WARN = 0xD29922;
let C_ERROR = 0xF0524F;

// Pages
let P_WELCOME = 0;
let P_OPTIONS = 1;
let P_PROGRESS = 2;
let P_FINISH = 3;
let P_ERROR = 4;

// ---------------------------------------------------------------------------
// State
// ---------------------------------------------------------------------------
let uninstall_mode = false;
let silent = false;
let elevated = false;
let page = 0;
let quit = false;
let exit_code = 0;

let scope = "User";
let install_dir = "";
let dir_edited = false;
let opt_desktop = true;
let opt_startmenu = true;
let opt_assoc = true;
let opt_path = false;
let opt_launch = true;
let opt_remove_settings = false;
let opt_nexa = true;        // install NexaC when it is missing

let nexa_path = "";
let notice = "";            // inline message on the options / confirm page
let error_msg = "";
let warnings: []string;
let steps: []string;
let step_i = 0;

let helper_ps = "";
let helper_out = "";
let elevate_target = "none";
let elevate_args = "none";

// Payload read back from this executable.
let self_data = "";
let pk_names: []string;
let pk_offs: []int;
let pk_sizes: []int;
let logo = 0;

// Keyboard shortcuts for the current frame (widgets read their own input).
let key_enter = false;
let key_escape = false;
let scope_i = 0;            // 0 = just me, 1 = all users (ui.radio works on ints)

// ---------------------------------------------------------------------------
// PowerShell helper: registry, shortcuts, PATH, elevation and the folder
// picker are all easier and safer from PowerShell than from cmd quoting.
// Parameters that would otherwise be empty are passed as "none" (a bare "-"
// or "" does not survive powershell -File argument binding).
// ---------------------------------------------------------------------------
let HELPER_SCRIPT: string = R"PS(
param(
  [string]$Action = '',
  [string]$Dir = '',
  [string]$Scope = 'User',
  [string]$Version = '',
  [int]$Desktop = 0,
  [int]$StartMenu = 0,
  [string]$Out = 'none',
  [string]$Target = 'none',
  [string]$ArgList = 'none'
)
$ErrorActionPreference = 'Stop'
$machine = $Scope -eq 'Machine'
$hive = if ($machine) { 'HKLM:' } else { 'HKCU:' }
$exe = Join-Path $Dir 'Nexium.exe'
$uninstaller = Join-Path $Dir 'Uninstall.exe'
$uninstKey = "$hive\Software\Microsoft\Windows\CurrentVersion\Uninstall\Nexium"
$appPathKey = "$hive\Software\Microsoft\Windows\CurrentVersion\App Paths\Nexium.exe"
$classes = "$hive\Software\Classes"

function Set-Value([string]$key, [string]$name, $value, [string]$kind = 'String') {
  if (-not (Test-Path -LiteralPath $key)) { New-Item -Path $key -Force | Out-Null }
  if ($name -eq '') { Set-Item -LiteralPath $key -Value $value }
  else { New-ItemProperty -LiteralPath $key -Name $name -Value $value -PropertyType $kind -Force | Out-Null }
}
function Remove-Key([string]$key) {
  if (Test-Path -LiteralPath $key) { Remove-Item -LiteralPath $key -Recurse -Force }
}
function Get-Default([string]$key) {
  if (-not (Test-Path -LiteralPath $key)) { return $null }
  return (Get-Item -LiteralPath $key).GetValue('')
}
function Shortcut-Paths {
  $programs = if ($machine) { [Environment]::GetFolderPath('CommonPrograms') } else { [Environment]::GetFolderPath('Programs') }
  $desktop = if ($machine) { [Environment]::GetFolderPath('CommonDesktopDirectory') } else { [Environment]::GetFolderPath('DesktopDirectory') }
  return @((Join-Path $programs 'Nexium.lnk'), (Join-Path $desktop 'Nexium.lnk'))
}
function Notify-Shell {
  Add-Type -Namespace Nexium -Name Shell -MemberDefinition '[DllImport("shell32.dll")] public static extern void SHChangeNotify(int e, uint f, IntPtr a, IntPtr b);'
  [Nexium.Shell]::SHChangeNotify(0x08000000, 0, [IntPtr]::Zero, [IntPtr]::Zero)
}
function Edit-Path([bool]$add) {
  $target = if ($machine) { 'Machine' } else { 'User' }
  $cur = [Environment]::GetEnvironmentVariable('Path', $target)
  if (-not $cur) { $cur = '' }
  $norm = $Dir.TrimEnd('\')
  $parts = @($cur -split ';' | Where-Object { $_ -and ($_.TrimEnd('\') -ine $norm) })
  if ($add) { $parts += $Dir }
  [Environment]::SetEnvironmentVariable('Path', ($parts -join ';'), $target)
}

try {
  switch ($Action) {
    'is-admin' {
      $p = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
      if ($p.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { exit 0 } else { exit 1 }
    }
    'running' {
      $hit = Get-Process -Name 'Nexium' -ErrorAction SilentlyContinue |
        Where-Object { $_.Path -and ($_.Path -ieq $exe) }
      if ($hit) { exit 1 } else { exit 0 }
    }
    'register' {
      $kb = [int]((Get-ChildItem -LiteralPath $Dir -File | Measure-Object -Property Length -Sum).Sum / 1KB)
      Set-Value $uninstKey 'DisplayName' 'Nexium'
      Set-Value $uninstKey 'DisplayVersion' $Version
      Set-Value $uninstKey 'Publisher' 'Nexium'
      Set-Value $uninstKey 'DisplayIcon' "$exe,0"
      Set-Value $uninstKey 'InstallLocation' $Dir
      Set-Value $uninstKey 'UninstallString' "`"$uninstaller`" --uninstall --scope $Scope"
      Set-Value $uninstKey 'QuietUninstallString' "`"$uninstaller`" --uninstall --silent --scope $Scope"
      Set-Value $uninstKey 'URLInfoAbout' 'https://github.com/Bobism-2009/Nexium'
      Set-Value $uninstKey 'NoModify' 1 'DWord'
      Set-Value $uninstKey 'NoRepair' 1 'DWord'
      Set-Value $uninstKey 'EstimatedSize' $kb 'DWord'
      Set-Value $appPathKey '' $exe
      Set-Value $appPathKey 'Path' $Dir
    }
    'associate' {
      Set-Value "$classes\Nexium.nxa" '' 'Nexa Source File'
      Set-Value "$classes\Nexium.nxa\DefaultIcon" '' "`"$exe`",0"
      Set-Value "$classes\Nexium.nxa\shell\open\command" '' "`"$exe`" `"%1`""
      Set-Value "$classes\.nxa\OpenWithProgids" 'Nexium.nxa' ''
      Set-Value "$classes\Applications\Nexium.exe\shell\open\command" '' "`"$exe`" `"%1`""
      Set-Value "$classes\Applications\Nexium.exe\SupportedTypes" '.nxa' ''
      # Remember what .nxa pointed at (NexaC registers NexaC.SourceFile) so uninstall can put it back.
      $prev = Get-Default "$classes\.nxa"
      if ($prev -and $prev -ne 'Nexium.nxa') { Set-Value $uninstKey 'PreviousNxaHandler' $prev }
      Set-Value "$classes\.nxa" '' 'Nexium.nxa'
      Notify-Shell
    }
    'shortcuts' {
      $shell = New-Object -ComObject WScript.Shell
      $paths = Shortcut-Paths
      $want = @($StartMenu, $Desktop)
      for ($i = 0; $i -lt 2; $i++) {
        if ($want[$i] -ne 1) { continue }
        $lnk = $shell.CreateShortcut($paths[$i])
        $lnk.TargetPath = $exe
        $lnk.WorkingDirectory = $Dir
        $lnk.IconLocation = "$exe,0"
        $lnk.Description = 'Nexium - IDE for the Nexa language'
        $lnk.Save()
      }
    }
    'path-add' { Edit-Path $true }
    'path-remove' { Edit-Path $false }
    'unshortcuts' {
      foreach ($p in (Shortcut-Paths)) { if (Test-Path -LiteralPath $p) { Remove-Item -LiteralPath $p -Force } }
    }
    'unregister' {
      $prev = $null
      if (Test-Path -LiteralPath $uninstKey) { $prev = (Get-Item -LiteralPath $uninstKey).GetValue('PreviousNxaHandler') }
      if ((Get-Default "$classes\.nxa") -eq 'Nexium.nxa') {
        if ($prev -and (Test-Path -LiteralPath "$classes\$prev")) { Set-Value "$classes\.nxa" '' $prev }
        else { Set-Item -LiteralPath "$classes\.nxa" -Value '' }
      }
      $owp = "$classes\.nxa\OpenWithProgids"
      if (Test-Path -LiteralPath $owp) { Remove-ItemProperty -LiteralPath $owp -Name 'Nexium.nxa' -ErrorAction SilentlyContinue }
      Remove-Key "$classes\Nexium.nxa"
      Remove-Key "$classes\Applications\Nexium.exe"
      Remove-Key $appPathKey
      Remove-Key $uninstKey
      Notify-Shell
    }
    'browse' {
      Add-Type -AssemblyName System.Windows.Forms
      $owner = New-Object System.Windows.Forms.Form -Property @{ TopMost = $true }
      $dlg = New-Object System.Windows.Forms.FolderBrowserDialog
      $dlg.Description = 'Choose where to install Nexium'
      $dlg.ShowNewFolderButton = $true
      if ($Dir -and (Test-Path -LiteralPath (Split-Path $Dir))) { $dlg.SelectedPath = Split-Path $Dir }
      if ($dlg.ShowDialog($owner) -eq 'OK') { [IO.File]::WriteAllText($Out, $dlg.SelectedPath); exit 0 }
      exit 1
    }
    'elevate' {
      Start-Process -FilePath $Target -ArgumentList $ArgList -Verb RunAs
    }
    'install-nexa' {
      # Latest NexaC release from GitHub, installed with NexaC's own installer
      # (which also sets up the C++ toolchain NexaC needs). It runs in its own
      # console window so its progress is visible.
      [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
      $rel = Invoke-RestMethod -Uri 'https://api.github.com/repos/Bobism-2009/Nexa-Lang/releases/latest' -Headers @{ 'User-Agent' = 'NexiumSetup' }
      $asset = $rel.assets | Where-Object { $_.name -like '*Windows.zip' } | Select-Object -First 1
      if (-not $asset) { exit 4 }
      $work = Join-Path $env:TEMP ("nexium-nexa-" + $PID)
      New-Item -ItemType Directory -Path $work -Force | Out-Null
      $zip = Join-Path $work $asset.name
      Invoke-WebRequest -Uri $asset.browser_download_url -OutFile $zip -UseBasicParsing
      Expand-Archive -LiteralPath $zip -DestinationPath $work -Force
      $inst = Get-ChildItem -LiteralPath $work -Recurse -Filter 'Installer.exe' | Select-Object -First 1
      if (-not $inst) { exit 4 }
      # Menu choice 2 is the per-user install; --system is the all-users one.
      # The trailing blank line answers the closing "Press Enter" prompt.
      $answers = Join-Path $work 'answers.txt'
      [IO.File]::WriteAllText($answers, "2`r`n`r`n")
      $argsList = if ($machine) { @('--system') } else { @() }
      $p = Start-Process -FilePath $inst.FullName -ArgumentList $argsList -WorkingDirectory $inst.DirectoryName -RedirectStandardInput $answers -Wait -PassThru
      Remove-Item -LiteralPath $work -Recurse -Force -ErrorAction SilentlyContinue
      $want = if ($machine) { Join-Path $env:ProgramFiles 'NexaC\NexaC.exe' } else { Join-Path $env:LOCALAPPDATA 'NexaC\NexaC.exe' }
      if (Test-Path -LiteralPath $want) { exit 0 } else { exit 1 }
    }
    default { exit 3 }
  }
  exit 0
} catch {
  exit 2
}
)PS";

fn b01(v: bool): string {
    if (v) return "1";
    return "0";
}

fn helper(action: string): int {
    return os.spawn_wait("powershell.exe", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
                         "-File", helper_ps, "-Action", action, "-Dir", install_dir, "-Scope", scope,
                         "-Version", VERSION, "-Desktop", b01(opt_desktop), "-StartMenu", b01(opt_startmenu),
                         "-Out", helper_out, "-Target", elevate_target, "-ArgList", elevate_args);
}

fn join(a: string, b: string): string {
    if (a.ends_with("\\") || a.ends_with("/")) return a + b;
    return a + "\\" + b;
}

// Trailing backslashes would escape the closing quote of a spawned argument.
fn clean_dir(d: string): string {
    let s = d.trim().replace("/", "\\");
    while (len(s) > 3 && s.ends_with("\\")) {
        s = s.substring(0, len(s) - 1);
    }
    return s;
}

fn default_dir(): string {
    if (scope == "Machine") {
        let pf = os.getenv("ProgramFiles");
        if (pf == "") pf = "C:\\Program Files";
        return join(pf, "Nexium");
    }
    return join(join(os.getenv("LOCALAPPDATA"), "Programs"), "Nexium");
}

// ---------------------------------------------------------------------------
// Payload: <stub><file>...<manifest><12-char manifest length>NXPK1
// Manifest lines are "name|offset|size".
// ---------------------------------------------------------------------------
fn load_payload(): bool {
    self_data = os.load(os.executable());
    let n = len(self_data);
    if (n < 17) return false;
    if (self_data.substring(n - 5, 5) != "NXPK1") return false;
    let mlen = (int)self_data.substring(n - 17, 12).trim();
    if (mlen <= 0 || mlen > n - 17) return false;
    let manifest = self_data.substring(n - 17 - mlen, mlen);
    for (line in manifest.split("\n")) {
        if (line.trim() == "") continue;
        let parts = line.split("|");
        if (len(parts) != 3) continue;
        pk_names.push(parts[0]);
        pk_offs.push((int)parts[1]);
        pk_sizes.push((int)parts[2]);
    }
    return len(pk_names) > 0;
}

fn has_file(name: string): bool {
    for (i, len(pk_names)) {
        if (pk_names[i] == name) return true;
    }
    return false;
}

fn payload(name: string): string {
    for (i, len(pk_names)) {
        if (pk_names[i] == name) return self_data.substring(pk_offs[i], pk_sizes[i]);
    }
    return "";
}

fn pad12(n: int): string {
    let s = (string)n;
    while (len(s) < 12) s = " " + s;
    return s;
}

// The uninstaller is the stub plus the icon: everything but the payload it no longer needs.
fn uninstaller_image(): string {
    let data = payload("stub");
    let manifest = "stub|0|" + (string)len(data) + "\n";
    if (has_file("nexium.ico")) {
        let ico = payload("nexium.ico");
        manifest += "nexium.ico|" + (string)len(data) + "|" + (string)len(ico) + "\n";
        data += ico;
    }
    return data + manifest + pad12(len(manifest)) + "NXPK1";
}

fn byte_at(s: string, i: int): int {
    return (int)(unsigned char)s[i];
}

fn u32_at(s: string, i: int): int {
    return byte_at(s, i) + byte_at(s, i + 1) * 256 + byte_at(s, i + 2) * 65536 + byte_at(s, i + 3) * 16777216;
}

// Picks the 128px PNG out of nexium.ico (or the largest one under it).
fn load_logo() {
    let ico = payload("nexium.ico");
    if (len(ico) < 6) return;
    let count = byte_at(ico, 4) + byte_at(ico, 5) * 256;
    let best = -1;
    let best_w = 0;
    for (i, count) {
        let e = 6 + i * 16;
        if (e + 16 > len(ico)) break;
        let w = byte_at(ico, e);
        if (w == 0) w = 256;
        if (w <= 128 && w > best_w) {
            best_w = w;
            best = e;
        }
    }
    if (best < 0) return;
    let size = u32_at(ico, best + 8);
    let off = u32_at(ico, best + 12);
    if (off + size > len(ico)) return;
    logo = gfx.decode(ico.substring(off, size));
}

// ---------------------------------------------------------------------------
// Drawing helpers. Text and widgets come from std/ui; the sidebar, step
// markers and ticks are plain gfx shapes in the theme's colours.
// ---------------------------------------------------------------------------
fn fill(x: int, y: int, w: int, h: int, c: int) {
    gfx.fill(x, y, w, h, (c >> 16) & 255, (c >> 8) & 255, c & 255);
}

fn line(x1: int, y1: int, x2: int, y2: int, c: int, t: int) {
    gfx.line(x1, y1, x2, y2, (c >> 16) & 255, (c >> 8) & 255, c & 255, t);
}

fn dot(cx: int, cy: int, r: int, c: int) {
    gfx.fill_circle(cx, cy, r, (c >> 16) & 255, (c >> 8) & 255, c & 255);
}

fn ring(cx: int, cy: int, r: int, c: int) {
    gfx.circle(cx, cy, r, (c >> 16) & 255, (c >> 8) & 255, c & 255);
}

fn check_mark(x: int, y: int, c: int) {
    line(x, y + 5, x + 4, y + 9, c, 2);
    line(x + 4, y + 9, x + 11, y, c, 2);
}

fn warn_mark(x: int, y: int) {
    dot(x + 6, y + 6, 6, C_WARN);
    fill(x + 5, y + 2, 2, 6, C_SIDEBAR);
    fill(x + 5, y + 9, 2, 2, C_SIDEBAR);
}

fn textc(x: int, y: int, s: string, size: int, c: int): int {
    return ui.text(x, y, s, size, (c >> 16) & 255, (c >> 8) & 255, c & 255);
}

// Text that no longer fits keeps its end, which is the informative part of a path.
fn fit(s: string, max_w: int, size: int): string {
    if (ui.text_width(s, size) <= max_w) return s;
    let t = s;
    while (len(t) > 1 && ui.text_width("..." + t, size) > max_w) {
        t = t.substring(1, len(t) - 1);
    }
    return "..." + t;
}

// Word-wrapped paragraph; returns the height it took.
fn para(x: int, y: int, s: string, max_w: int, size: int, c: int): int {
    let lh = ui.text_height(size) + 5;
    let lines = 0;
    let cur = "";
    for (w in s.split(" ")) {
        if (cur == "") {
            cur = w;
        } else if (ui.text_width(cur + " " + w, size) <= max_w) {
            cur += " " + w;
        } else {
            textc(x, y + lines * lh, cur, size, c);
            lines++;
            cur = w;
        }
    }
    if (cur != "") {
        textc(x, y + lines * lh, cur, size, c);
        lines++;
    }
    return lines * lh;
}

// Buttons sit right-aligned in the footer; index 0 is the rightmost.
fn footer_button(index: int, label: string, style: string): bool {
    let bw = 116;
    let x = W - 28 - bw - index * (bw + 10);
    return ui.button(x, FOOT + 18, bw, 36, label, style);
}

// ---------------------------------------------------------------------------
// Chrome
// ---------------------------------------------------------------------------
fn draw_sidebar() {
    fill(0, 0, SIDEBAR, H, C_SIDEBAR);
    fill(SIDEBAR - 1, 0, 1, H, C_LINE);
    let lx = SIDEBAR / 2 - 44;
    if (logo != 0) {
        gfx.blit(lx, 40, logo, 88, 88);
    } else {
        fill(lx, 40, 88, 88, C_ACCENT);
        ui.heading(lx + 30, 62, "N", 40);
    }
    let title = "Nexium";
    ui.heading((SIDEBAR - ui.text_width(title, 26)) / 2, 142, title, 26);
    let sub = (uninstall_mode ? "Uninstall " : "Setup ") + VERSION;
    ui.caption((SIDEBAR - ui.text_width(sub, 13)) / 2, 178, sub);

    let labels = ["Welcome", "Options", "Install", "Finish"];
    let current = page;
    if (page == P_ERROR) current = P_PROGRESS;
    if (uninstall_mode) {
        labels = ["Confirm", "Remove", "Done"];
        if (page == P_WELCOME) current = 0;
        else if (page == P_PROGRESS) current = 1;
        else current = 2;
    }
    for (i, len(labels)) {
        let cx = 48;
        let cy = 250 + i * 48;
        if (i + 1 < len(labels)) {
            let rail = C_LINE;
            if (i < current) rail = C_ACCENT;
            fill(cx, cy + 13, 2, 22, rail);
        }
        let label_c = C_MUTED;
        if (i < current) {
            dot(cx, cy, 12, C_ACCENT);
            check_mark(cx - 6, cy - 5, 0xFFFFFF);
        } else if (i == current) {
            let fillc = C_ACCENT;
            if (page == P_ERROR) fillc = C_ERROR;
            dot(cx, cy, 12, fillc);
            let n = (string)(i + 1);
            textc(cx - ui.text_width(n, 13) / 2, cy - 8, n, 13, 0xFFFFFF);
            label_c = C_TEXT;
        } else {
            ring(cx, cy, 12, 0x4A4E57);
            let n = (string)(i + 1);
            textc(cx - ui.text_width(n, 13) / 2, cy - 8, n, 13, C_MUTED);
        }
        textc(cx + 26, cy - 10, labels[i], 15, label_c);
    }
    ui.caption(24, H - 34, "github.com/Bobism-2009/Nexium");
}

fn draw_footer() {
    fill(SIDEBAR, FOOT, W - SIDEBAR, H - FOOT, C_SIDEBAR);
    fill(SIDEBAR, FOOT, W - SIDEBAR, 1, C_LINE);
}

fn page_title(s: string, sub: string) {
    ui.heading(CX, 34, s, 26);
    if (sub != "") ui.caption(CX, 72, sub);
}

// Status of the Nexa compiler Nexium drives for Run / Build.
fn draw_nexa_status(y: int) {
    ui.panel(CX, y, CW, 76);
    if (nexa_path != "") {
        dot(CX + 24, y + 26, 5, C_OK);
        textc(CX + 40, y + 16, "Nexa compiler found", 15, C_TEXT);
        ui.caption(CX + 40, y + 42, fit(nexa_path, CW - 60, 13));
    } else {
        dot(CX + 24, y + 26, 5, C_WARN);
        textc(CX + 40, y + 16, "The Nexa compiler is not installed", 15, C_TEXT);
        opt_nexa = ui.checkbox(CX + 40, y + 44, "Install it too (downloads NexaC from GitHub)", opt_nexa);
    }
}

// ---------------------------------------------------------------------------
// Install steps
// ---------------------------------------------------------------------------
fn step_label(s: string): string {
    switch (s) {
        case "folder": return "Creating the install folder";
        case "app": return "Copying Nexium.exe";
        case "docs": return "Copying README and license";
        case "uninstaller": return "Writing the uninstaller";
        case "register": return "Registering with Windows";
        case "associate": return "Associating .nxa files";
        case "shortcuts": return "Creating shortcuts";
        case "path": return "Adding Nexium to PATH";
        case "nexa": return "Installing Nexa (see its window)";
        case "refresh": return "Finishing up";
        case "check": return "Checking that Nexium is closed";
        case "unshortcuts": return "Removing shortcuts";
        case "unregister": return "Removing registry entries";
        case "unpath": return "Removing Nexium from PATH";
        case "files": return "Removing program files";
        case "settings": return "Removing your settings";
        case "cleanup": return "Removing the uninstaller";
        default: return s;
    }
}

fn fail(msg: string) {
    error_msg = msg;
    page = P_ERROR;
    exit_code = 1;
}

fn warn(msg: string) {
    warnings.push(msg);
}

fn plan_install() {
    steps = ["folder", "app", "docs", "uninstaller", "register"];
    if (opt_assoc) steps.push("associate");
    if (opt_desktop || opt_startmenu) steps.push("shortcuts");
    if (opt_path) steps.push("path");
    if (nexa_path == "" && opt_nexa) steps.push("nexa");
    steps.push("refresh");
    step_i = 0;
    warnings = [];
}

fn plan_uninstall() {
    steps = ["check", "unshortcuts", "unregister", "unpath", "files"];
    if (opt_remove_settings) steps.push("settings");
    steps.push("cleanup");
    step_i = 0;
    warnings = [];
}

fn write_file(name: string, data: string): bool {
    return os.save(join(install_dir, name), data) == 1;
}

fn run_step(s: string) {
    switch (s) {
        case "folder":
            if (file.isdir(install_dir) == 0) file.mkdir(install_dir);
            if (file.isdir(install_dir) == 0) {
                fail("Could not create " + install_dir + ". Choose another folder, or install for all users as administrator.");
            }
            break;
        case "app":
            if (!write_file("Nexium.exe", payload("Nexium.exe"))) {
                fail("Could not write Nexium.exe to " + install_dir + ". If Nexium is running, close it and try again.");
                break;
            }
            // Any runtime DLLs in the payload go next to it.
            for (name in pk_names) {
                if (name.lower().ends_with(".dll") && !write_file(name, payload(name))) {
                    fail("Could not write " + name + " to " + install_dir + ". If Nexium is running, close it and try again.");
                    break;
                }
            }
            // Nexium 1.x shipped the MinGW runtime as DLLs; 2.x needs none, so
            // an update clears out the ones it left behind.
            for (old in ["libstdc++-6.dll", "libgcc_s_seh-1.dll", "libmcfgthread-2.dll", "libwinpthread-1.dll", "imgui.ini"]) {
                if (!pk_names.contains(old) && file.exists(join(install_dir, old)) == 1) { file.remove(join(install_dir, old)); }
            }
            break;
        case "docs":
            if (has_file("README.md") && !write_file("README.md", payload("README.md"))) warn("README.md was not copied.");
            if (has_file("LICENSE") && !write_file("LICENSE.txt", payload("LICENSE"))) warn("LICENSE was not copied.");
            break;
        case "uninstaller":
            if (!write_file("Uninstall.exe", uninstaller_image())) warn("The uninstaller could not be written.");
            break;
        case "register":
            if (helper("register") != 0) warn("Nexium could not be added to Apps & features.");
            break;
        case "associate":
            if (helper("associate") != 0) warn(".nxa files could not be associated with Nexium.");
            break;
        case "shortcuts":
            if (helper("shortcuts") != 0) warn("Some shortcuts could not be created.");
            break;
        case "path":
            if (helper("path-add") != 0) warn("Nexium could not be added to PATH.");
            break;
        case "nexa":
            if (helper("install-nexa") == 0) {
                nexa_path = "installed";
            } else {
                warn("The Nexa compiler could not be installed. Get it from github.com/Bobism-2009/Nexa-Lang.");
            }
            break;
        case "refresh":
            os.spawn_wait("ie4uinit.exe", "-show");
            break;

        case "check":
            if (helper("running") == 1) fail("Nexium is still running. Close it, then run the uninstaller again.");
            break;
        case "unshortcuts":
            if (helper("unshortcuts") != 0) warn("Some shortcuts could not be removed.");
            break;
        case "unregister":
            if (helper("unregister") != 0) warn("Some registry entries could not be removed.");
            break;
        case "unpath":
            if (helper("path-remove") != 0) warn("PATH could not be updated.");
            break;
        case "files":
            // Only what setup installed: a custom folder may hold the user's own files.
            for (name in ["Nexium.exe", "README.md", "LICENSE.txt", "imgui.ini", "libstdc++-6.dll",
                          "libgcc_s_seh-1.dll", "libmcfgthread-2.dll", "libwinpthread-1.dll"]) {
                let p = join(install_dir, name);
                if (file.exists(p) == 1 && file.remove(p) == 0) warn("Could not remove " + p);
            }
            break;
        case "settings":
            let cfg = join(os.getenv("APPDATA"), "Nexium");
            if (file.exists(cfg) == 1 && file.remove_all(cfg) == 0) warn("Could not remove " + cfg);
            break;
        case "cleanup":
            schedule_self_delete();
            break;
    }
}

// A running program cannot delete itself, so a detached cmd script waits for
// this process to exit, removes Uninstall.exe and the folder if it is empty,
// then deletes itself.
fn schedule_self_delete() {
    let tmp = join(os.tempdir(), "nexium-uninstall-" + (string)os.getpid() + ".cmd");
    let un = join(install_dir, "Uninstall.exe");
    let script = "@echo off\r\n" +
                 "for /l %%i in (1,1,30) do (\r\n" +
                 "  del /f /q \"" + un + "\" >nul 2>&1\r\n" +
                 "  if not exist \"" + un + "\" goto gone\r\n" +
                 "  ping -n 2 127.0.0.1 >nul\r\n" +
                 ")\r\n" +
                 ":gone\r\n" +
                 "rmdir \"" + install_dir + "\" >nul 2>&1\r\n" +
                 "del /f /q \"%~f0\" >nul 2>&1\r\n";
    if (os.save(tmp, script) == 1) {
        os.spawn("cmd.exe", "/c", tmp);
    } else {
        warn("Delete " + install_dir + " yourself to finish.");
    }
}

// ---------------------------------------------------------------------------
// Elevation for all-users installs
// ---------------------------------------------------------------------------
fn is_admin(): bool {
    return helper("is-admin") == 0;
}

// Spaces become '|' so the path survives Start-Process without nested
// quoting; '|' cannot occur in a Windows path.
fn relaunch_elevated(): bool {
    elevate_target = os.executable();
    let a = "--elevated --scope " + scope + " --dir " + install_dir.replace(" ", "|");
    if (uninstall_mode) {
        a = "--uninstall " + a + " --settings " + b01(opt_remove_settings);
    } else {
        a += " --desktop " + b01(opt_desktop) + " --startmenu " + b01(opt_startmenu) +
             " --assoc " + b01(opt_assoc) + " --path " + b01(opt_path) + " --nexa " + b01(opt_nexa);
    }
    elevate_args = a;
    let ok = helper("elevate") == 0;
    elevate_target = "none";
    elevate_args = "none";
    return ok;
}

// Checks run when Install / Uninstall is pressed. Returns true to go ahead
// in this process.
fn preflight(): bool {
    install_dir = clean_dir(install_dir);
    if (!uninstall_mode) {
        let absolute = len(install_dir) >= 3 && install_dir[1] == ':' && install_dir[2] == '\\';
        if (!absolute) {
            notice = "Enter a full folder path, like C:\\Tools\\Nexium.";
            return false;
        }
        if (len(install_dir) <= 3) {
            notice = "Choose a folder, not the root of a drive.";
            return false;
        }
    }
    if (helper("running") == 1) {
        notice = "Nexium is running from this folder. Close it first.";
        return false;
    }
    if (scope == "Machine" && !elevated && !is_admin()) {
        if (relaunch_elevated()) {
            quit = true;
        } else {
            notice = "Administrator permission was not granted.";
        }
        return false;
    }
    notice = "";
    return true;
}

// ---------------------------------------------------------------------------
// Pages
// ---------------------------------------------------------------------------
fn page_welcome() {
    page_title("Welcome to Nexium", "Setup will guide you through installing Nexium " + VERSION + ".");
    let y = 108;
    y += para(CX, y, "Nexium is a fast, native IDE for the Nexa programming language.", CW, 15, C_TEXT);
    y += 14;
    ui.panel(CX, y, CW, 150, "What you get");
    let bullets = ["Nexa highlighting, completion and live errors",
                   "A built-in terminal with one-key Run and Build",
                   "Quick open, symbol outline and workspace search",
                   "An AI coding agent that can edit and run your project"];
    let by = y + 54;
    for (bl in bullets) {
        check_mark(CX + 20, by + 5, C_ACCENT);
        textc(CX + 42, by, bl, 15, C_TEXT);
        by += 22;
    }
    draw_nexa_status(y + 166);

    if (footer_button(0, "Cancel", "secondary") || key_escape) quit = true;
    if (footer_button(1, "Next", "primary") || key_enter) page = P_OPTIONS;
}

fn page_options() {
    page_title("Install options", "Choose who Nexium is for and where it goes.");

    ui.panel(CX, 100, CW, 142, "Install for");
    let prev = scope_i;
    scope_i = ui.radio(CX + 20, 152, "Just me", scope_i, 0);
    ui.caption(CX + 140, 154, "No administrator rights needed");
    scope_i = ui.radio(CX + 20, 182, "All users", scope_i, 1);
    ui.caption(CX + 140, 184, "Asks for administrator permission");
    if (scope_i != prev) {
        scope = "User";
        if (scope_i == 1) scope = "Machine";
        if (!dir_edited) install_dir = default_dir();
    }
    let before = install_dir;
    install_dir = ui.textbox(CX + 20, 206 - 2, CW - 40 - 110, install_dir, "Install folder");
    if (install_dir != before) dir_edited = true;
    if (ui.button(CX + CW - 20 - 100, 204, 100, ui.text_height() + 16, "Browse", "secondary")) {
        if (helper("browse") == 0) {
            let picked = clean_dir(file.read(helper_out));
            if (picked != "") {
                if (!picked.lower().ends_with("nexium")) picked = join(picked, "Nexium");
                install_dir = picked;
                dir_edited = true;
            }
        }
    }

    ui.panel(CX, 258, CW, 170, "Additional tasks");
    opt_startmenu = ui.checkbox(CX + 20, 310, "Add to the Start menu", opt_startmenu);
    opt_desktop = ui.checkbox(CX + 20, 338, "Create a desktop shortcut", opt_desktop);
    opt_assoc = ui.checkbox(CX + 20, 366, "Open .nxa files with Nexium", opt_assoc);
    opt_path = ui.checkbox(CX + 20, 394, "Add Nexium to PATH", opt_path);

    if (notice != "") {
        textc(CX, 444, fit(notice, CW, 14), 14, C_ERROR);
    } else if (file.exists(join(install_dir, "Nexium.exe")) == 1) {
        textc(CX, 444, "Nexium is already installed here and will be updated.", 14, 0x6CB6FF);
    }

    if (footer_button(0, "Cancel", "secondary")) quit = true;
    let install = footer_button(1, "Install", "primary");
    if (footer_button(2, "Back", "ghost")) {
        notice = "";
        page = P_WELCOME;
    }
    if (install) {
        if (install_dir.trim() == "") {
            notice = "Choose a folder to install into.";
        } else if (preflight()) {
            plan_install();
            page = P_PROGRESS;
        }
    }
}

fn page_progress() {
    let title = "Installing Nexium";
    if (uninstall_mode) title = "Removing Nexium";
    page_title(title, "This takes a few seconds.");
    let total = len(steps);
    let label = "Done";
    if (step_i < total) label = step_label(steps[step_i]) + "...";
    textc(CX, 108, label, 15, C_TEXT);
    let frac = 0.0;
    if (total > 0) frac = (float)step_i / (float)total;
    ui.progress(CX, 138, CW, frac);
    for (i, step_i) {
        let y = 170 + i * 26;
        check_mark(CX + 2, y + 4, C_OK);
        textc(CX + 24, y, step_label(steps[i]), 14, C_MUTED);
    }
    ui.caption(W - 28 - ui.text_width("Please wait", 13), FOOT + 28, "Please wait");
}

fn draw_warnings(y: int): int {
    for (w in warnings) {
        warn_mark(CX, y + 3);
        y += para(CX + 22, y, w, CW - 22, 14, C_WARN) + 4;
    }
    return y;
}

fn page_finish() {
    if (uninstall_mode) {
        page_title("Nexium was removed", "");
        let y = 96;
        y += para(CX, y, "Nexium has been uninstalled from this computer. Your Nexa projects were not touched.", CW, 15, C_TEXT);
        draw_warnings(y + 14);
        if (footer_button(0, "Close", "primary") || key_enter || key_escape) quit = true;
        return;
    }
    page_title("Nexium is ready", "Setup finished installing Nexium " + VERSION + ".");
    ui.panel(CX, 100, CW, 86, "Installed to");
    textc(CX + 20, 150, fit(install_dir, CW - 40, 15), 15, 0x6CB6FF);
    let y = draw_warnings(204);
    if (nexa_path == "") {
        y += 6;
        y += para(CX, y, "Install the Nexa compiler to run and build programs from Nexium.", CW - 130, 14, C_MUTED);
        if (ui.button(CX + CW - 116, y - 30, 116, 32, "Get Nexa", "secondary")) os.open(NEXA_URL);
    }
    opt_launch = ui.checkbox(CX, FOOT - 42, "Launch Nexium now", opt_launch);
    if (footer_button(0, "Finish", "primary") || key_enter) {
        // Through Explorer so Nexium does not inherit this process's elevation.
        if (opt_launch) os.spawn("explorer.exe", join(install_dir, "Nexium.exe"));
        quit = true;
    }
}

fn page_error() {
    let title = "Setup could not finish";
    if (uninstall_mode) title = "Uninstall stopped";
    page_title(title, "");
    ui.panel(CX, 90, CW, 120);
    dot(CX + 26, 118, 7, C_ERROR);
    fill(CX + 25, 113, 2, 6, 0xFFFFFF);
    fill(CX + 25, 121, 2, 2, 0xFFFFFF);
    para(CX + 46, 108, error_msg, CW - 66, 15, C_TEXT);
    draw_warnings(226);
    if (footer_button(0, "Close", "primary") || key_escape) quit = true;
    let again = "Back";
    if (uninstall_mode) again = "Retry";
    if (footer_button(1, again, "secondary")) {
        exit_code = 0;
        if (uninstall_mode) page = P_WELCOME;
        else page = P_OPTIONS;
    }
}

fn page_confirm_uninstall() {
    page_title("Uninstall Nexium", "Remove Nexium " + VERSION + " from this computer.");
    ui.panel(CX, 100, CW, 150, "This removes");
    let items = ["Nexium and its runtime files", "Start menu and desktop shortcuts",
                 "The .nxa file association and PATH entry"];
    let y = 152;
    for (it in items) {
        check_mark(CX + 20, y + 5, C_ACCENT);
        textc(CX + 42, y, it, 15, C_TEXT);
        y += 24;
    }
    ui.caption(CX, 262, "From: " + fit(install_dir, CW - 60, 13));
    ui.caption(CX, 282, "Your Nexa projects are not touched.");
    opt_remove_settings = ui.checkbox(CX, 316, "Also remove my Nexium settings", opt_remove_settings);
    if (notice != "") textc(CX, 356, fit(notice, CW, 14), 14, C_ERROR);

    if (footer_button(0, "Cancel", "secondary") || key_escape) quit = true;
    if (footer_button(1, "Uninstall", "danger") || key_enter) {
        if (preflight()) {
            plan_uninstall();
            page = P_PROGRESS;
        }
    }
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------
fn parse_args(args: []string) {
    let i = 1;
    while (i < len(args)) {
        let a = args[i];
        let v = i + 1 < len(args) ? args[i + 1] : "";
        if (a == "--uninstall") uninstall_mode = true;
        else if (a == "--silent" || a == "/S") silent = true;
        else if (a == "--elevated") elevated = true;
        else if (a == "--scope") {
            scope = "User";
            scope_i = 0;
            if (v == "Machine") {
                scope = "Machine";
                scope_i = 1;
            }
            i++;
        }
        else if (a == "--dir") { install_dir = v.replace("|", " "); dir_edited = true; i++; }
        else if (a == "--desktop") { opt_desktop = (v == "1"); i++; }
        else if (a == "--startmenu") { opt_startmenu = (v == "1"); i++; }
        else if (a == "--assoc") { opt_assoc = (v == "1"); i++; }
        else if (a == "--path") { opt_path = (v == "1"); i++; }
        else if (a == "--settings") { opt_remove_settings = (v == "1"); i++; }
        else if (a == "--nexa") { opt_nexa = (v == "1"); i++; }
        i++;
    }
}

fn nexa_flag_given(args: []string): bool {
    for (a in args) {
        if (a == "--nexa") return true;
    }
    return false;
}

fn run_all_steps() {
    while (step_i < len(steps) && page == P_PROGRESS) {
        run_step(steps[step_i]);
        step_i++;
    }
    if (page == P_PROGRESS) page = P_FINISH;
}

fn main(args: []string) {
    parse_args(args);
    if (!load_payload()) {
        os.messagebox("This setup file is damaged or incomplete. Download NexiumSetup.exe again.", "Nexium Setup");
        os.exit(1);
    }
    if (!uninstall_mode && !has_file("Nexium.exe")) {
        os.messagebox("This setup file does not contain Nexium.exe.", "Nexium Setup");
        os.exit(1);
    }
    helper_ps = join(os.tempdir(), "nexium-setup-" + (string)os.getpid() + ".ps1");
    helper_out = join(os.tempdir(), "nexium-setup-" + (string)os.getpid() + ".txt");
    if (os.save(helper_ps, HELPER_SCRIPT) == 0) {
        os.messagebox("Could not write to the temp folder.", "Nexium Setup");
        os.exit(1);
    }
    if (install_dir == "") {
        if (uninstall_mode) install_dir = clean_dir(os.exe_dir());
        else install_dir = default_dir();
    }
    install_dir = clean_dir(install_dir);
    nexa_path = os.which("NexaC");
    if (nexa_path == "") nexa_path = os.which("Nexa");

    if (silent) {
        if (!nexa_flag_given(args)) opt_nexa = false;
        if (scope == "Machine" && !is_admin()) {
            file.remove(helper_ps);
            os.exit(5);
        }
        if (uninstall_mode) plan_uninstall();
        else plan_install();
        page = P_PROGRESS;
        run_all_steps();
        file.remove(helper_ps);
        file.remove(helper_out);
        os.exit(exit_code);
    }

    // An elevated relaunch starts straight at the progress page.
    if (elevated) {
        if (uninstall_mode) plan_uninstall();
        else plan_install();
        page = P_PROGRESS;
    }

    let window_title: string = uninstall_mode ? "Uninstall Nexium" : "Nexium Setup";
    ui.open(window_title, W, H);
    gfx.maxfps(60);
    load_logo();
    if (logo != 0) gfx.icon(logo);

    while (!quit) {
        gfx.poll();
        if (gfx.closed() == 1) {
            // Closing mid-install finishes the remaining steps rather than
            // leaving a half-registered install behind.
            if (page == P_PROGRESS) run_all_steps();
            break;
        }
        key_enter = (gfx.pressed("enter") == 1);
        key_escape = (gfx.pressed("escape") == 1);

        ui.theme("dark");
        ui.accent(0, 120, 212);
        ui.rounding(6);
        ui.font_size(15);
        ui.background();
        draw_sidebar();
        draw_footer();
        if (page == P_WELCOME) {
            if (uninstall_mode) page_confirm_uninstall();
            else page_welcome();
        } else if (page == P_OPTIONS) {
            page_options();
        } else if (page == P_PROGRESS) {
            page_progress();
        } else if (page == P_FINISH) {
            page_finish();
        } else {
            page_error();
        }
        gfx.present();

        // One step per frame, after the frame showing it has been presented.
        if (page == P_PROGRESS) {
            if (step_i < len(steps)) {
                run_step(steps[step_i]);
                if (page == P_PROGRESS) step_i++;
            } else {
                page = P_FINISH;
            }
        }
    }
    file.remove(helper_ps);
    file.remove(helper_out);
    os.exit(exit_code);
}
