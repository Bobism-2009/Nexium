// ---- documents ---------------------------------------------------------------------------

struct Snap {
    lines: []string;
    cy: int;
    cx: int;
    ay: int;
    ax: int;
    ver: int;
}

struct Buf {
    path: string;
    name: string;
    kind: int;          // 0 file, 1 settings, 2 welcome
    lines: []string;
    lang: int;
    cy: int;
    cx: int;
    ay: int;
    ax: int;
    want: int;
    sy: int;
    sx: int;
    ver: int;
    saved: int;
    crlf: bool;
    undo: []Snap;
    redo: []Snap;
    hl_st: []int;
    hl_dl: []string;
    hl_valid: int;
    mtime: long;
    preview: bool;
}

let bufs: []Buf;
let active = -1;
let ver_seq = 1;

// the active document, unpacked (doc_load / doc_store move it in and out of bufs)
