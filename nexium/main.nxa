// Nexium: a code editor for the Nexa language, written in Nexa and drawn with
// std/ui. The generated C++ is kept in transpiled/ (see the Makefile).

#include <std/ui>
#include <std/io>
#include <std/os>
#include <std/file>
#include <std/json>
#include <std/math>
#include "native.hpp"
#include "state.nxa"
#include "draw.nxa"
#include "text.nxa"
#include "highlight.nxa"
#include "buffer.nxa"
#include "editor.nxa"
#include "workspace.nxa"
#include "commands.nxa"
#include "panel.nxa"
#include "agent.nxa"
#include "chrome.nxa"

// ---- settings --------------------------------------------------------------------------------------

fn settings_file(): string {
    // NEXIUM_CONFIG_DIR points a test copy somewhere other than the real settings
    let dir = os.getenv("NEXIUM_CONFIG_DIR");
    if (len(dir) == 0) { dir = path_join(os.config_dir(), "Nexium"); }
    if (!file.isdir(dir)) { file.mkdir(dir); }
    return path_join(dir, "settings.json");
}

fn load_settings() {
    settings_path = settings_file();
    if (!file.isfile(settings_path)) { return; }
    let j: Json = json.parse(file.read(settings_path));
    if (!j.ok() || !j.is_object()) { return; }
    if (j.has("folder")) { folder = j.get("folder").as_string(); }
    if (j.has("nexac")) { nexac = j.get("nexac").as_string(); }
    // 1.x stored "Nexa" as the default; empty now means "look for one"
    if (nexac == "Nexa") { nexac = ""; }
    if (j.has("run_args")) { run_args = j.get("run_args").as_string(); }
    if (j.has("sidebar_w")) { sidebar_w = j.get("sidebar_w").as_int(); }
    if (j.has("panel_h")) { panel_h = j.get("panel_h").as_int(); }
    if (j.has("show_sidebar")) { show_sidebar = j.get("show_sidebar").as_bool(); }
    if (j.has("show_panel")) { show_panel = j.get("show_panel").as_bool(); }
    if (j.has("font_size")) { font_size = clamp(j.get("font_size").as_int(), 8, 32); }
    if (j.has("render_whitespace")) { show_ws = j.get("render_whitespace").as_bool(); }
    if (j.has("auto_save")) { auto_save = j.get("auto_save").as_bool(); }
    if (j.has("maximized")) { win_max = j.get("maximized").as_bool(); }
    if (j.has("window_w")) { win_w = j.get("window_w").as_int(); }
    if (j.has("window_h")) { win_h = j.get("window_h").as_int(); }
    if (j.has("recent")) {
        let r: Json = j.get("recent");
        for (i, r.len()) { recent.push(r.get(i).as_string()); }
    }
    if (j.has("font_family") && len(j.get("font_family").as_string()) > 0) { font_family = j.get("font_family").as_string(); }
    if (j.has("minimap")) { show_minimap = j.get("minimap").as_bool(); }
    if (j.has("show_agent")) { show_agent = j.get("show_agent").as_bool(); }
    if (j.has("agent_w")) { agent_w = j.get("agent_w").as_int(); }
    if (j.has("nexa_lang")) { nexa_lang = j.get("nexa_lang").as_string(); }
    if (j.has("provider")) { ag_provider = j.get("provider").as_string(); }
    if (!provider_ids().contains(ag_provider)) { ag_provider = "openai"; }
    if (j.has("mode")) { ag_mode = j.get("mode").as_string() == "chat" ? "chat" : "agent"; }
    if (j.has("temperature")) { ag_temp = j.get("temperature").as_float(); }
    if (j.has("providers") && j.get("providers").is_object()) {
        let ps: Json = j.get("providers");
        for (id in provider_ids()) {
            if (!ps.has(id)) { continue; }
            let slot: Json = ps.get(id);
            if (slot.has("api_key")) { ag_keys[id] = slot.get("api_key").as_string(); }
            if (slot.has("base_url")) { ag_urls[id] = slot.get("base_url").as_string(); }
            if (slot.has("model")) { ag_models[id] = slot.get("model").as_string(); }
            if (slot.has("custom_model")) { ag_custom[id] = slot.get("custom_model").as_string(); }
        }
    }
    if (j.has("open_files")) {
        let r: Json = j.get("open_files");
        for (i, r.len()) { last_files.push(r.get(i).as_string()); }
    }
}

// Writes our keys into settings.json, keeping any others (the agent settings
// from Nexium 1.x among them).
fn save_settings() {
    if (len(settings_path) == 0) { return; }
    let j: Json = json.object();
    if (file.isfile(settings_path)) {
        let old: Json = json.parse(file.read(settings_path));
        if (old.ok() && old.is_object()) { j = old; }
    }
    j.set("folder", json.string(folder));
    j.set("nexac", json.string(nexac));
    j.set("run_args", json.string(run_args));
    j.set("sidebar_w", json.int((int)(sidebar_w / SCALE)));
    j.set("panel_h", json.int((int)(panel_h / SCALE)));
    j.set("show_sidebar", json.bool(show_sidebar));
    j.set("show_panel", json.bool(show_panel));
    j.set("font_size", json.int(font_size));
    j.set("render_whitespace", json.bool(show_ws));
    j.set("auto_save", json.bool(auto_save));
    j.set("maximized", json.bool(nx_maximized() == 1));
    j.set("font_family", json.string(font_family));
    j.set("minimap", json.bool(show_minimap));
    j.set("show_agent", json.bool(show_agent));
    j.set("agent_w", json.int((int)(agent_w / SCALE)));
    j.set("nexa_lang", json.string(nexa_lang));
    j.set("provider", json.string(ag_provider));
    j.set("mode", json.string(ag_mode));
    j.set("temperature", json.float(ag_temp));
    let ps: Json = json.object();
    for (id in provider_ids()) {
        let slot: Json = json.object();
        slot.set("api_key", json.string(ag_keys.has(id) ? ag_keys[id] : ""));
        slot.set("base_url", json.string(ag_urls.has(id) ? ag_urls[id] : ""));
        slot.set("model", json.string(ag_models.has(id) ? ag_models[id] : ""));
        slot.set("custom_model", json.string(ag_custom.has(id) ? ag_custom[id] : ""));
        ps.set(id, slot);
    }
    j.set("providers", ps);
    if (nx_maximized() == 0 && nx_minimized() == 0) {
        j.set("window_w", json.int((int)(win_w / SCALE)));
        j.set("window_h", json.int((int)(win_h / SCALE)));
    }
    let r: Json = json.array();
    for (p in recent) { r.push(json.string(p)); }
    j.set("recent", r);
    let o: Json = json.array();
    for (i, len(bufs)) {
        let p: string = bufs[i].path;
        if (bufs[i].kind == 0 && len(p) > 0) { o.push(json.string(p)); }
    }
    j.set("open_files", o);
    file.write(settings_path, json.stringify(j, 2));
}

fn remember_files() {
    frame_dirty = true;
}

fn update_title() {
    let t = "Nexium";
    if (len(folder) > 0) { t = file.basename(folder) + " - Nexium"; }
    if (active >= 0 && active < len(bufs)) {
        let nm: string = bufs[active].name;
        t = nm + (buf_dirty(active) ? " ●" : "") + " - " + t;
    }
    nx_title(t);
}

// ---- input ---------------------------------------------------------------------------------------------

// A click (pressed and released) inside the rectangle this frame.
fn clicked_in(x: int, y: int, w: int, h: int): bool {
    return up_this_frame && inside(up_x, up_y, x, y, w, h) && inside(down_x, down_y, x, y, w, h);
}

fn collect_events() {
    ev_t.clear();
    ev_a.clear();
    ev_x.clear();
    ev_y.clear();
    ev_m.clear();
    ev_c.clear();
    while (true) {
        let t: int = nx_next();
        if (t == 0) { break; }
        ev_t.push(t);
        ev_a.push(nx_ev_a());
        ev_x.push(nx_ev_x());
        ev_y.push(nx_ev_y());
        ev_m.push(nx_ev_mods());
        ev_c.push(nx_ev_clicks());
    }
}

fn is_ctrl(m: int): bool {
    return (m & M_CTRL) != 0 && (m & M_ALT) == 0;
}

// Shortcuts that work wherever the focus is; true if the key was one.
fn global_key(vk: int, m: int): bool {
    let ctrl = is_ctrl(m);
    let shift = (m & M_SHIFT) != 0;
    if (chord_k) {
        chord_k = false;
        if (ctrl && vk == 79) { run_cmd("file.openFolder"); return true; }
        if (vk == 83) { run_cmd("file.saveAll"); return true; }
        if (ctrl && vk == 87 || vk == 87) { run_cmd("file.closeAll"); return true; }
        return true;
    }
    if (ctrl && vk == 75 && !shift) {
        chord_k = true;
        flash("(Ctrl+K) was pressed. Waiting for second key of chord...");
        return true;
    }
    if (vk == K_F1 || (ctrl && shift && vk == 80)) { run_cmd("view.palette"); return true; }
    if (ctrl && !shift && vk == 80) { run_cmd("view.quickOpen"); return true; }
    if (ctrl && shift && vk == 79) { run_cmd("go.symbol"); return true; }
    if (ctrl && !shift && vk == 71) { run_cmd("go.line"); return true; }
    if (ctrl && !shift && vk == 78) { run_cmd("file.new"); return true; }
    if (ctrl && !shift && vk == 79) { run_cmd("file.open"); return true; }
    if (ctrl && !shift && vk == 83) { run_cmd("file.save"); return true; }
    if (ctrl && shift && vk == 83) { run_cmd("file.saveAs"); return true; }
    if (ctrl && !shift && (vk == 87 || vk == 115)) { run_cmd("file.close"); return true; }
    if (ctrl && vk == K_COMMA) { run_cmd("app.settings"); return true; }
    if (ctrl && !shift && vk == 66) { run_cmd("view.sidebar"); return true; }
    if (ctrl && shift && vk == 76) { run_cmd("view.agent"); return true; }
    if (ctrl && !shift && vk == 74) { run_cmd("view.panel"); return true; }
    if (ctrl && shift && vk == 77) { run_cmd("view.problems"); return true; }
    if (ctrl && shift && vk == 85) { run_cmd("view.output"); return true; }
    if (ctrl && shift && vk == 69) { run_cmd("view.explorer"); return true; }
    if (ctrl && shift && vk == 70) { run_cmd("view.search"); return true; }
    if (ctrl && vk == K_BACKTICK) { run_cmd("view.terminal"); return true; }
    if (ctrl && (vk == K_PLUS || vk == 107)) { run_cmd("view.zoomIn"); return true; }
    if (ctrl && (vk == K_MINUS || vk == 109)) { run_cmd("view.zoomOut"); return true; }
    if (ctrl && (vk == 48 || vk == 96)) { run_cmd("view.zoomReset"); return true; }
    if (ctrl && vk == K_TAB) { run_cmd(shift ? "go.prevTab" : "go.nextTab"); return true; }
    if (ctrl && vk == K_PGDN) { run_cmd("go.nextTab"); return true; }
    if (ctrl && vk == K_PGUP) { run_cmd("go.prevTab"); return true; }
    if (vk == K_F5 && shift) { run_cmd("run.stop"); return true; }
    if (vk == K_F5) { run_cmd("run.run"); return true; }
    if (ctrl && shift && vk == 66) { run_cmd("run.build"); return true; }
    if ((m & M_CTRL) != 0 && (m & M_ALT) != 0 && vk == 66) { run_cmd("run.build"); return true; }
    if (ctrl && !shift && vk == 70) { run_cmd("edit.find"); return true; }
    if (ctrl && !shift && vk == 72) { run_cmd("edit.replace"); return true; }
    if (vk == K_F3 && is_file_tab()) {
        if (len(fld_text[FLD_FIND]) == 0) {
            open_find(false);
        } else {
            run_cmd(shift ? "edit.findPrev" : "edit.findNext");
        }
        return true;
    }
    if (vk == 18 || vk == 121) {
        // Alt or F10 alone: nothing (the native menu is off)
        return false;
    }
    return false;
}

fn on_key(vk: int, m: int) {
    blink_ms = now_ms;
    frame_dirty = true;
    if (vk == 16 || vk == 17 || vk == 18 || vk == 91 || vk == 92) { return; }
    if (menu_open >= 0) {
        if (vk == K_ESC) {
            menu_open = -1;
            return;
        }
    }
    if (quick_open && (vk == K_ESC || vk == K_ENTER || vk == K_UP || vk == K_DOWN || vk == K_PGUP || vk == K_PGDN)) {
        quick_key_press(vk, m);
        return;
    }
    if (global_key(vk, m)) { return; }
    if (quick_open) {
        quick_key_press(vk, m);
        return;
    }
    if (focus == F_FIND || focus == F_REPLACE) {
        find_field_key(vk, m);
        return;
    }
    if (focus == F_TERM) {
        term_key(vk, m);
        return;
    }
    if (focus == F_AGENT && show_agent) {
        agent_key(vk, m);
        return;
    }
    if (focus == F_KEY) {
        if (vk == K_ESC || vk == K_ENTER || vk == K_TAB) {
            focus = F_NONE;
            return;
        }
        if (fld_key(FLD_KEY, vk, m) == 2) { key_field_changed(); }
        return;
    }
    if (focus == F_SEARCH) {
        search_key(vk, m);
        return;
    }
    if (focus == F_RENAME) {
        rename_key(vk, m);
        return;
    }
    if (focus == F_TREE) {
        tree_key(vk, m);
        return;
    }
    if (is_file_tab()) {
        focus = F_EDITOR;
        ed_key(vk, m);
    }
}

fn on_char(cp: int) {
    blink_ms = now_ms;
    frame_dirty = true;
    if ((nx_mods() & M_CTRL) != 0 && (nx_mods() & M_ALT) == 0) { return; }
    if (chord_k) { return; }
    if (quick_open) {
        fld_char(FLD_QUICK, cp);
        return;
    }
    if (focus == F_FIND || focus == F_REPLACE) {
        let id = focus == F_REPLACE ? FLD_REPLACE : FLD_FIND;
        fld_char(id, cp);
        if (id == FLD_FIND) { find_as_you_type(); }
        return;
    }
    if (focus == F_TERM) {
        fld_char(FLD_TERM, cp);
        term_follow = true;
        return;
    }
    if (focus == F_AGENT && show_agent) {
        fld_char(FLD_AGENT, cp);
        return;
    }
    if (focus == F_KEY) {
        fld_char(FLD_KEY, cp);
        key_field_changed();
        return;
    }
    if (focus == F_SEARCH) {
        fld_char(FLD_SEARCH, cp);
        return;
    }
    if (focus == F_RENAME) {
        fld_char(FLD_RENAME, cp);
        return;
    }
    if (focus == F_TREE) { return; }
    if (focus == F_EDITOR && is_file_tab()) { ed_char(cp); }
}

fn on_mouse_down(btn: int, x: int, y: int, clicks: int, m: int) {
    frame_dirty = true;
    if (btn == 0) {
        down_x = x;
        down_y = y;
    }
    if (menu_open >= 0) {
        if (menu_mouse(x, y)) { return; }
    }
    if (quick_open) {
        if (quick_mouse(x, y)) { return; }
    }
    if (comp_click(x, y)) { return; }
    comp_open = false;
    if (y < TOOLBAR_H) {
        if (btn == 0) { toolbar_mouse(x, y); }
        return;
    }
    if (y >= win_h - STATUS_H) {
        if (btn == 0) { status_mouse(x, y); }
        return;
    }
    if (x < ACT_W) {
        if (btn == 0) { activity_mouse(x, y); }
        return;
    }
    if (show_agent && x >= agent_x() - px(2)) {
        if (x < agent_x() + px(3)) {
            drag = 7;
            drag_off = x - agent_x();
        } else if (btn == 0) {
            agent_mouse(x, y, btn);
        }
        return;
    }
    if (show_sidebar && x >= side_x + sidebar_w - px(2) && x < side_x + sidebar_w + px(3)) {
        drag = 1;
        drag_off = x - (side_x + sidebar_w);
        return;
    }
    if (show_sidebar && x < side_x + sidebar_w) {
        if (rename_mode > 0 && focus == F_RENAME && view == 0) {
            // a click elsewhere in the tree commits the name being typed
            let ri = tree_rows.index_of("\x01new");
            if (rename_mode == 3) { ri = tree_rows.index_of(rename_path); }
            if (ri < 0 || y < tree_row_y(ri) || y >= tree_row_y(ri) + ROW_H) { finish_rename(true); }
        }
        if (view == 0) {
            explorer_mouse(x, y, btn, clicks);
        } else if (view == 1) {
            search_mouse(x, y, m);
        } else {
            outline_mouse(x, y);
        }
        return;
    }
    if (show_panel && y >= panel_y - px(2) && y < panel_y + px(3)) {
        drag = 2;
        drag_off = y - panel_y;
        return;
    }
    if (show_panel && y >= panel_y) {
        panel_mouse(x, y, btn, clicks);
        return;
    }
    if (y < TOOLBAR_H + TABS_H) {
        tabs_mouse(x, y, btn, clicks);
        return;
    }
    if (!is_file_tab()) {
        if (active_kind() == 1 && inside(x, y, key_x, key_y, key_w, key_h)) {
            focus = F_KEY;
            fld_caret[FLD_KEY] = len(fld_text[FLD_KEY]);
            fld_anchor[FLD_KEY] = fld_caret[FLD_KEY];
        } else {
            focus = F_NONE;
        }
        return;
    }
    if (y < ed_y) { return; }
    if (find_mouse(x, y, m)) { return; }
    if (btn == 0) {
        ed_mouse_down(x, y, clicks, m);
    } else if (btn == 1) {
        focus = F_EDITOR;
        hit_test(x, y);
        sel_bounds();
        let in_sel = has_sel() && (hit_y > sel_y1 || (hit_y == sel_y1 && hit_x >= sel_x1)) && (hit_y < sel_y2 || (hit_y == sel_y2 && hit_x <= sel_x2));
        if (!in_sel) { set_cursor(hit_y, hit_x, false); }
        menu_open = 102;
        menu_x = x;
        menu_y = y;
    }
}

fn on_mouse_up(btn: int, x: int, y: int) {
    if (btn == 0) {
        up_this_frame = true;
        up_x = x;
        up_y = y;
        if (drag == 1 || drag == 2 || drag == 7) { save_settings(); }
        drag = 0;
    }
    frame_dirty = true;
}

fn on_wheel(delta: int, x: int, y: int, horizontal: bool) {
    frame_dirty = true;
    if (menu_open >= 0) { return; }
    if (quick_open) {
        let n = len(quick_items);
        if (n > 0) { quick_sel = clamp(quick_sel - delta / 120, 0, n - 1); }
        return;
    }
    if (show_agent && x >= agent_x() && y > TOOLBAR_H) {
        agent_wheel(delta);
        return;
    }
    if (show_sidebar && x >= side_x && x < side_x + sidebar_w && y > TOOLBAR_H) {
        if (view == 0) {
            tree_scroll = imax(0, tree_scroll - delta * ROW_H * 3 / 120);
        } else if (view == 2) {
            outline_scroll = imax(0, outline_scroll - delta * ROW_H * 3 / 120);
        } else {
            search_scroll = imax(0, search_scroll - delta * ROW_H * 3 / 120);
        }
        return;
    }
    if (show_panel && y >= panel_y) {
        panel_wheel(delta);
        return;
    }
    if (y >= TOOLBAR_H && y < TOOLBAR_H + TABS_H && x >= main_x) {
        tab_scroll = imax(0, tab_scroll - delta / 2);
        return;
    }
    if (active >= 0 && !is_file_tab() && x >= main_x && y >= TOOLBAR_H + TABS_H) {
        page_scroll = imax(0, page_scroll - delta * px(60) / 120);
        return;
    }
    if (is_file_tab() && x >= main_x && y >= ed_y) {
        if (horizontal) {
            ed_wheel(-delta, true);
        } else {
            ed_wheel(delta, false);
        }
    }
}

fn handle_input() {
    up_this_frame = false;
    for (i, len(ev_t)) {
        let t: int = ev_t[i];
        let a: int = ev_a[i];
        if (t == 1) {
            on_key(a, ev_m[i]);
        } else if (t == 2) {
            on_char(a);
        } else if (t == 3) {
            on_mouse_down(a, ev_x[i], ev_y[i], ev_c[i], ev_m[i]);
        } else if (t == 4) {
            on_mouse_up(a, ev_x[i], ev_y[i]);
        } else if (t == 5 || t == 6) {
            on_wheel(a, ev_x[i], ev_y[i], t == 6);
        }
    }
    // drags continue while the button is held
    if (drag != 0) {
        if (nx_mouse_down(0) == 0 && !up_this_frame) { drag = 0; }
    }
    if (drag == 1) {
        sidebar_w = clamp(mx - side_x - drag_off, px(170), win_w / 2);
        frame_dirty = true;
    } else if (drag == 2) {
        panel_h = clamp(win_h - STATUS_H - (my - drag_off), px(100), win_h - px(240));
        frame_dirty = true;
    } else if (drag == 3 || drag == 4) {
        if (is_file_tab()) { ed_drag(); }
    } else if (drag == 6) {
        if (is_file_tab()) { minimap_drag(); }
    } else if (drag == 7) {
        agent_w = clamp(win_w - mx + drag_off, px(280), win_w / 2);
        frame_dirty = true;
    }
}

fn update_cursor_shape() {
    let c = 0;
    if (drag == 1 || drag == 7) {
        c = 2;
    } else if (drag == 2) {
        c = 3;
    } else if (drag == 3) {
        c = 1;
    } else if (menu_open < 0 && !quick_open) {
        if (show_sidebar && mx >= side_x + sidebar_w - px(2) && mx < side_x + sidebar_w + px(3) && my > TOOLBAR_H && my < win_h - STATUS_H) {
            c = 2;
        } else if (show_agent && mx >= agent_x() - px(2) && mx < agent_x() + px(3) && my > TOOLBAR_H && my < win_h - STATUS_H) {
            c = 2;
        } else if (show_agent && mx >= agent_x() && inside(mx, my, ag_in_x, ag_in_y, ag_in_w - px(64), ag_in_h)) {
            c = 1;
        } else if (show_panel && my >= panel_y - px(2) && my < panel_y + px(3) && mx >= main_x) {
            c = 3;
        } else if (is_file_tab() && mx >= text_x && mx < ed_x + ed_w - SCROLL_W - mm_w() && my >= ed_y && my < ed_y + ed_h) {
            c = 1;
            if (find_open) {
                find_layout();
                if (inside(mx, my, fw_x, fw_y, fw_w, fw_h)) { c = 0; }
            }
            if ((nx_mods() & M_CTRL) != 0) { c = 4; }
        }
    }
    nx_cursor(c);
}

// ---- frame -----------------------------------------------------------------------------------------------

fn draw_frame() {
    tip_text = "";
    ui.background();
    layout();
    if (active < 0) {
        draw_watermark();
    } else if (active_kind() == 0) {
        draw_editor();
        draw_crumbs();
    } else if (active_kind() == 1) {
        draw_settings_page();
    } else {
        draw_welcome();
    }
    draw_panel();
    if (len(bufs) > 0) { draw_tabs(); }
    draw_sidebar();
    draw_agent();
    draw_activity();
    draw_status();
    draw_toolbar();
    if (show_panel && (drag == 2 || (hovered(main_x, panel_y - px(2), main_w, px(5)) && drag == 0))) {
        fill(main_x, panel_y - 1, main_w, px(3), C_ACCENT);
    }
    draw_completion();
    draw_quick();
    draw_menu();
    draw_tooltip();
}

fn confirm_quit(): bool {
    doc_store();
    for (i, len(bufs)) {
        if (buf_dirty(i)) {
            switch_to(i);
            let r: int = nx_ask_save(bufs[i].name);
            if (r == 0) { return false; }
            if (r == 1 && !save_doc()) { return false; }
        }
    }
    return true;
}

fn open_arg(p: string) {
    if (file.isdir(p)) {
        set_folder(p);
    } else if (file.isfile(p)) {
        open_file(file.abspath(p), false);
        if (len(folder) == 0) { set_folder(file.dirname(file.abspath(p))); }
    }
}

fn main(args: []string) {
    test_mode = len(os.getenv("NEXIUM_OFFSCREEN")) > 0;
    let scale_pct: int = nx_dpi_init();
    SCALE = scale_pct / 100.0;
    if (SCALE < 1.0) { SCALE = 1.0; }
    load_settings();
    sidebar_w = px(sidebar_w);
    panel_h = px(panel_h);
    agent_w = px(agent_w);
    let w0 = px(win_w);
    let h0 = px(win_h);
    ui.open("Nexium", w0, h0);
    nx_init(px(640), px(420));
    nx_place(w0, h0, win_max ? 1 : 0);
    ui.theme("dark");
    ui.accent(0, 120, 212);
    ui.rounding(px(4));
    ui.font_size(px(13));
    metrics_init();
    fld_init();
    hl_init();
    cmd_init();
    doc_load(-1);
    detect_compiler_version();

    if (len(args) > 1) {
        for (i, len(args)) {
            if (i > 0) { open_arg(args[i]); }
        }
    } else {
        if (len(folder) > 0 && file.isdir(folder)) {
            let f = folder;
            folder = "";
            set_folder(f);
        } else {
            folder = "";
        }
        for (p in last_files) {
            if (file.isfile(p)) { open_file(p, false); }
        }
        if (len(bufs) > 0) { switch_to(0); }
    }
    read_git_branch();
    update_title();
    if (show_panel && panel_tab == 2) { ensure_terminal(); }

    let was_focused = 1;
    let last_frame = 0;
    while (!quit) {
        gfx.poll();
        if (nx_close_requested() == 1 || quit_requested) {
            quit_requested = false;
            if (confirm_quit()) { break; }
        }
        now_ms = (int)nx_ms();
        let cw_: int = nx_client_w();
        let ch_: int = nx_client_h();
        if (test_mode && (cw_ <= 0 || ch_ <= 0)) {
            cw_ = gfx.width();
            ch_ = gfx.height();
        }
        if ((nx_minimized() == 1 && !test_mode) || cw_ <= 0 || ch_ <= 0) {
            nx_wait(100);
            continue;
        }
        if (cw_ != gfx.width() || ch_ != gfx.height()) {
            gfx.resize(cw_, ch_, 1);
            frame_dirty = true;
        }
        win_w = cw_;
        win_h = ch_;
        mx = nx_mouse_x();
        my = nx_mouse_y();
        // coming back to the window: pick up changes made on disk
        let f: int = nx_focused();
        if (f == 1 && was_focused == 0) {
            refresh_tree();
            check_disk_changes();
        }
        if (f == 0 && was_focused == 1 && auto_save) { save_all(); }
        was_focused = f;
        collect_events();
        layout();
        handle_input();
        poll_processes();
        agent_poll();
        maybe_check();
        let dropped = gfx.drop();
        while (len(dropped) > 0) {
            open_arg(dropped);
            dropped = gfx.drop();
        }
        update_cursor_shape();
        draw_frame();
        if (test_mode) {
            test_hook();
        }
        gfx.present();
        let t = buf_title_key();
        if (t != last_title) {
            last_title = t;
            update_title();
        }
        // idle: wait for input instead of spinning, but wake for the caret
        // blink and for running processes
        let busy = drag != 0 || task_proc >= 0 || check_proc >= 0 || len(ev_t) > 0 || agent_busy();
        if (!busy) {
            nx_wait(term_proc >= 0 ? 50 : 250);
        } else {
            let spent = (int)nx_ms() - now_ms;
            if (spent < 8) { nx_sleep(8 - spent); }
        }
    }
    save_settings();
    agent_stop();
    if (term_proc >= 0) { nx_proc_free(term_proc); }
    if (task_proc >= 0) { nx_proc_free(task_proc); }
}

// Automated tests (NEXIUM_OFFSCREEN set) ask for a picture of the frame by
// creating shot.req in the config folder.
fn test_hook() {
    let dir = file.dirname(settings_path);
    let req = path_join(dir, "shot.req");
    if (file.exists(req)) {
        gfx.save(path_join(dir, "shot.bmp"));
        file.remove(req);
    }
}

fn buf_title_key(): string {
    if (active < 0) { return folder; }
    let nm: string = bufs[active].name;
    return folder + "|" + nm + (buf_dirty(active) ? "*" : "");
}
